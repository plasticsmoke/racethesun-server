# deploy.conf — VPS settings for deploy.sh
# Copy this to deploy.conf and fill in your values.
# This file is NOT committed to source control.

VPS_HOST="user@your-vps-hostname"
VPS_APP_DIR="~/racethesun-server"
VPS_PORT=8080

# Timezone for daily world reset (midnight in this timezone).
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
RESET_TIMEZONE="America/Chicago"
